<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.v2.speech</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>sleep 20 &amp;&amp; exec /opt/homebrew/bin/python3.11 /Users/matthiasschreiber/Jarvis-2.0/speech_input.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/matthiasschreiber/Jarvis-2.0</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/matthiasschreiber/Library/Logs/jarvis-v2/speech.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/matthiasschreiber/Library/Logs/jarvis-v2/speech.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin</string>
    </dict>
</dict>
</plist>
